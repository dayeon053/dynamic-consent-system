# 로컬 실행용 환경변수 템플릿. 이 파일을 복사해 .env로 저장하고 실제 값을 채운 뒤 저장하면,
# backend/consentradar/build.gradle의 bootRun 태스크가 자동으로 읽어 실행 환경에 주입한다
# (./gradlew bootRun 실행 시에만 적용 — 별도로 export할 필요 없음). .env는 .gitignore에
# 이미 등록되어 있어 커밋되지 않는다. 이 .env.example 파일 자체는 실제 키 값을 담지 않으므로
# 커밋해도 안전하다.

# OpenAI API 키. 비워두거나 LLM_ENABLED=false면 LlmClient가 카카오 목업 응답만 반환한다.
OPENAI_API_KEY=

# true로 설정해야 실제 OpenAI 호출이 나간다 (기본값 false).
LLM_ENABLED=true

# 필요 시에만 덮어쓴다 — 기본값은 application.yml 참고.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0
